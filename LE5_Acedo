#include <stdio.h>

int main() {
    int numbers[] = {1, 2, 3, 4, 5, 0};
    int sum = 0;
    int i = 0;

    while (1) {
        printf("Number: %d\n", numbers[i]);

        if (numbers[i] <= 0) {
            break;
        }

        sum = sum + numbers[i];
        i++;
    }

    printf("\nTotal sum of positive numbers: %d\n", sum);

    return 0;
}
