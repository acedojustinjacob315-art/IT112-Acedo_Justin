#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *file;
    int i;
    
    // Hardcoded student records built directly into the code
    char names[2][50] = {"Alice Smith", "Bob Jones"};
    int ages[2] = {20, 22};
    char courses[2][50] = {"Computer Science", "Information Technology"};
    int n = 2; // Number of records to store
    
    char buffer[256];

    // 1. Create a text file named "student_records.txt" using fopen() with write mode "w"
    file = fopen("student_records.txt", "w");
    if (file == NULL) {
        printf("Error opening file for writing!\n");
        return 1;
    }

    // 2. Write each student's information automatically to the student_records file
    for (i = 0; i < n; i++) {
        fprintf(file, "Name: %s, Age: %d, Course: %s\n", names[i], ages[i], courses[i]);
    }

    // Close the file after writing
    fclose(file);

    // 3. Open the text file using read mode "r"[cite: 1]
    file = fopen("student_records.txt", "r");
    if (file == NULL) {
        printf("Error opening file for reading!\n");
        return 1;
    }

    printf("=== Reading stored data from 'student_records.txt' ===\n");
    
    // 4. Read the file line-by-line using fgets() and display it on the terminal[cite: 1]
    while (fgets(buffer, sizeof(buffer), file) != NULL) {
        printf("%s", buffer);
    }

    // Close the file after reading
    fclose(file);

    return 0;
}
