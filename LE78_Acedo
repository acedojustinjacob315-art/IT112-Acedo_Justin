#include <stdio.h>
#include <ctype.h> // For tolower() function

int main() {
    // ==========================================
    // Part 1: Finding the Largest Element in an Array
    // ==========================================
    printf("=== Part 1: Largest Element in an Array ===\n");
    int n;
    
    printf("Enter the number of elements you want to enter: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid input for the number of elements.\n");
        return 1;
    }
    
    int arr[n];
    printf("Enter %d integers:\n", n);
    for (int i = 0; i < n; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &arr[i]);
    }
    
    // Assume the first element is the largest initially
    int largest = arr[0];
    for (int i = 1; i < n; i++) {
        if (arr[i] > largest) {
            largest = arr[i];
        }
    }
    
    printf("The largest element in the array is: %d\n\n", largest);
    
    // Clear the input buffer before reading a string
    while (getchar() != '\n');

    // ==========================================
    // Part 2: Counting the Number of Vowels in a String
    // ==========================================
    printf("=== Part 2: Counting Vowels in a String ===\n");
    char str[256];
    int vowelCount = 0;
    
    printf("Enter a sentence or word: ");
    // Read a line of text including spaces
    fgets(str, sizeof(str), stdin);
    
    // Go through each character of the string
    for (int i = 0; str[i] != '\0'; i++) {
        char ch = tolower(str[i]); // Convert to lowercase to check both cases easily
        
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
            vowelCount++;
        }
    }
    
    printf("Total number of vowels found: %d\n", vowelCount);
    
    return 0;
}
